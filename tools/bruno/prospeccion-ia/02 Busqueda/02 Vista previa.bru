      "organizationLocations": [
        "Bogota, Colombia"
      ],
      "organizationIndustries": [
        "hospital & health care"
      ],
      "organizationNumEmployeesRanges": [
        "51,200",
        "201,500"
      ],
      "keywords": []
    }
  }
}

