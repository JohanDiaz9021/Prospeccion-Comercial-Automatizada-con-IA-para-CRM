      }
    },
    {
      "label": "Prospección IA: mini front",
      "dependsOrder": "sequence",
      "dependsOn": [
        "CRM: MySQL",
        "Prospección: Gemini simulado (8771)",
        "Prospección: Apollo simulado (8772)",
        "CRM: msa-prospeccion (8099)",
        "Prospección: mini front (4300)"
      ],
      "problemMatcher": []
    },
    {
      "label": "Prospección: Gemini simulado (8771)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/crm-local/servicio.ps1", "-Servicio", "gemini"],
      "isBackground": true,
      "presentation": { "group": "crm", "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "crm-local",
        "pattern": { "regexp": "^__crm_sin_problemas__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^== Iniciando",
          "endsPattern": "(Gemini simulado en|Hay GEMINI_API_KEY|Traceback)"
        }
      }
    },
    {
      "label": "Prospección: Apollo simulado (8772)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/crm-local/servicio.ps1", "-Servicio", "apollo"],
      "isBackground": true,
