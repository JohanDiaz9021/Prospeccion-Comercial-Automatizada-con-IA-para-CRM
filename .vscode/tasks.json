        "pattern": { "regexp": "^__crm_sin_problemas__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^== Iniciando",
          "endsPattern": "(Apollo simulado en|Hay APOLLO_API_KEY|Traceback)"
        }
      }
    },
    {
      "label": "Prospección: mini front (4300)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/crm-local/servicio.ps1", "-Servicio", "minifront"],
      "isBackground": true,
      "presentation": { "group": "crm", "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": {
