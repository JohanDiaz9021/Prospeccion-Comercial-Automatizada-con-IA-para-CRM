    },
    {
      "label": "CRM: mf-cotizaciones (4201)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/crm-local/servicio.ps1", "-Servicio", "mf"],
      "isBackground": true,
      "presentation": { "group": "crm", "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": {
