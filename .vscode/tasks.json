        "pattern": { "regexp": "^__crm_sin_problemas__$" },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^== Iniciando",
          "endsPattern": "(Mini front en|Traceback)"
        }
      }
    },
    {
      "label": "CRM: abrir navegador",
      "type": "process",
      "command": "cmd.exe",
      "args": ["/c", "start", "", "http://localhost:4200"],
      "presentation": { "reveal": "never" },
      "problemMatcher": []
    },
    {
      "label": "CRM: detener todo",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/crm-local/servicio.ps1", "-Servicio", "detener"],
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
