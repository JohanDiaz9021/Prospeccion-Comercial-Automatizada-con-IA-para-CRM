# =====================================================================
# msa-prospeccion-crm - variables de entorno (VALORES DE EJEMPLO, FALSOS)
# Copia este archivo como .env y ajusta los valores. El .env NO se sube.
# En el perfil local, la aplicación lee este .env (spring.config.import).
# Comentarios siempre en líneas aparte (Docker Compose toma lo que va
# después del valor como parte del valor).
# =====================================================================

# --- Servidor (puerto por asignar por el equipo del CRM) ---
SERVER_PORT=8099

# --- Eureka ---
# En local va apagado si el servicio corre solo; tools\crm-local\iniciar-crm.ps1 lo enciende con el CRM completo.
EUREKA_CLIENT_ENABLED=false
# En local: http://localhost:8761/eureka/
EUREKA_URL=http://eureka.example.invalid:8761/eureka/

# --- JWT emitido por el CRM ---
# Clave HMAC en Base64 con la que msa-security firma el token (la misma JWT_SECRET_KEY del gateway).
# En local es una clave inventada: los tokens de prueba se generan con tools/token-local.
# En qa/prod debe ser exactamente la del gateway. Nunca se sube la real.
JWT_SECRET_KEY=0cFttCcy4uFrl1WMx37oztXHWYu36BvSvIz6myqY0VYqUkJ5LOXhOqqoJkxwsngawtvBblnC9kkgRtWd5FMjtg==

# --- AWS SSM Parameter Store (credenciales por tenant y llaves) ---
AWS_REGION=us-east-1
AWS_SSM_TENANT_BASE_PATH=/config/gtcproject/tenant_db/

# --- Prospección ---
# Lista separada por comas de los tenants donde corre el robot.
PROSPECCION_TENANTS_ENABLED=tenant_demo
# Encender los jobs programados (false por defecto).
PROSPECCION_JOBS_ENABLED=false
# Proveedor de buzón: gmail | graph | smtp | none. smtp = Mailpit en local (5.2): atrapa los correos, no los entrega.
#   docker compose -f docker-compose.local.yml --profile correo up -d mailpit   (correos en http://localhost:8025)
MAILBOX_PROVIDER=none
# Buzón que envía y nombre que ve el destinatario. En local, si se deja vacío: prospeccion@gtc-prueba.local
MAILBOX_FROM_ADDRESS=
MAILBOX_FROM_NAME=Equipo Comercial GTC
# SMTP (solo smtp). En local ya apuntan a Mailpit (localhost:1025 y API en localhost:8025).
# Por seguridad solo se acepta un servidor local; otro exige SMTP_ALLOW_REMOTE_HOST=true a propósito.
SMTP_HOST=
SMTP_PORT=1025
MAILPIT_API_URL=
# Pie legal de cada correo (1.10). Sin estos tres datos no se envía nada. En local hay valores de prueba.
LEGAL_COMPANY_NAME=GTC Corporation
LEGAL_NIT=
LEGAL_ADDRESS=
LEGAL_PRIVACY_POLICY_URL=
# 5.6: quien responde pasa al vendedor con una tarea en el CRM. CODE de los catálogos del CRM: 246 tipo (obligatorio),
# 247 prioridad y 248 periodicidad (vacío = no se envía). Por confirmar con el equipo CRM.
HANDOFF_ENABLED=true
HANDOFF_TASK_TYPE_CODE=1
HANDOFF_PRIORITY_CODE=
HANDOFF_PERIODICITY_CODE=
HANDOFF_DUE_BUSINESS_DAYS=1
HANDOFF_DUE_HOUR=10:00
# En qa/prod va por el gateway, por ejemplo https://<dominio del gateway>/msa-prospeccion/public/unsubscribe
UNSUBSCRIBE_BASE_URL=http://localhost:8099/msa-prospeccion/public/unsubscribe
UNSUBSCRIBE_TOKEN_SECRET_SSM_PARAMETER=/example/prospeccion/unsubscribe-secret
# Solo local: secreto para firmar los enlaces de baja (5.5), mínimo 32 caracteres. En qa/prod sale de SSM.
UNSUBSCRIBE_TOKEN_SECRET=secreto-local-de-prueba-para-enlaces-de-baja-0001

# --- Integraciones (solo URL base y NOMBRE del parámetro SSM de la llave) ---
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_API_KEY_SSM_PARAMETER=/example/prospeccion/apollo-api-key
HUNTER_BASE_URL=https://api.hunter.io/v2
HUNTER_API_KEY_SSM_PARAMETER=/example/prospeccion/hunter-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY_SSM_PARAMETER=/example/prospeccion/gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Contactos por llamada al calificar (tarea 3.5). Opcional, 10 por defecto.
GEMINI_QUALIFICATION_BATCH_SIZE=10

# --- Reglas para aceptar un correo (tarea 4.1, docs/negocio/correo-de-contacto.md). Opcionales ---
EMAIL_TRUST_APOLLO_VERIFIED=true
EMAIL_ACCEPTED_HUNTER_STATUSES=valid,accept_all
EMAIL_MIN_FINDER_SCORE=80

# --- Topes de créditos por tenant (tarea 4.2, docs/negocio/creditos.md). 0 = sin tope. Ajustar al plan ---
CREDITS_ALERT_PERCENT=80
APOLLO_MONTHLY_CREDITS=1000
APOLLO_CREDITS_PER_SEARCH=50
HUNTER_MONTHLY_CREDITS=500
HUNTER_CREDITS_PER_SEARCH=50
# Búsqueda (3.2): personas NUEVAS por ejecución (techo del gasto diario de cada campaña) y páginas de Apollo.
SEARCH_MAX_NEW_PER_RUN=25
SEARCH_MAX_PAGES=5
# Hora del job de campañas (cada campaña decide si le toca: diaria o semanal). Formato cron de Spring.
SCHEDULED_SEARCH_CRON=0 0 6 * * MON-FRI
# Precio en USD por crédito para el costo estimado (opcional).
APOLLO_CREDIT_COST_USD=
HUNTER_CREDIT_COST_USD=

# --- Permisos (tarea 2.9, docs/negocio/permisos.md) ---
# Operaciones del módulo por rol del token. ROLE_SUPERADMIN tiene todas; un rol sin variable no tiene ninguna.
# En local no hace falta: application-local.yml ya le da todo a ADMINISTRADOR.
# PROSPECCION_SECURITY_OPERATIONSBYROLE_COMERCIAL=VER,APROBAR

# --- Seguimiento del buzón (tarea 5.4, docs/negocio/seguimiento.md) ---
MAILBOX_LOOKBACK_HOURS=48
TRACKING_SOFT_BOUNCE_LIMIT=3
# Píxel de aperturas: dato aproximado, apagado. Requiere visto bueno de Jurídica y abrir la ruta en el gateway.
OPEN_PIXEL_ENABLED=false
OPEN_PIXEL_BASE_URL=

# --- MySQL local (docker-compose.local.yml) ---
# 3306 suele estar ocupado en el PC de desarrollo: se publica en otro puerto.
MYSQL_HOST_PORT=3308
MYSQL_DATABASE=crm_tenant_local
MYSQL_USER=prospeccion_local
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# --- Tenant local (reemplaza a SSM en el perfil local) ---
LOCAL_TENANT_CODE=tenant_demo

# --- Llaves de prueba SOLO en local (tareas 1.7 y 2.12): planes gratis, nunca las de QA o produccion ---
# QA y produccion leen las llaves de AWS SSM. Deja estos valores vacios en .env.example.
# Vacía en local = Apollo simulado (tools/mini-front/apollo_simulado.py): personas y empresas inventadas.
APOLLO_API_KEY=
HUNTER_API_KEY=
# Gemini en local: llave de AI Studio SOLO con datos de prueba (la capa gratuita no debe recibir datos personales).
# Vacía: tools\crm-local arranca el servicio contra el Gemini SIMULADO (tools/mini-front/gemini_simulado.py, reglas fijas).
GEMINI_API_KEY=
